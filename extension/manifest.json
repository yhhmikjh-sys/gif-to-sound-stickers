{
  "manifest_version": 3,
  "name": "StikDesi Sender",
  "version": "1.8.2",
  "description": "Send StikDesi sound stickers from WhatsApp Web.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lovable.app/*",
        "http://localhost/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "api.js",
        "webp-sticker.js",
        "wa-format.js",
        "whatsapp.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "wa-native.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StikDesi Sender",
    "default_icon": "icon.png"
  },
  "host_permissions": [
    "https://c--b64fa0cb-35d5-43aa-8ca5-3939e0394a0d-prod.lovable.cloud/*",
    "https://*.giphy.com/*"
  ],
  "minimum_chrome_version": "111"
}