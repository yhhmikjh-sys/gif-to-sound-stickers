{
  "manifest_version": 3,
  "name": "StikDesi Sender",
  "version": "1.1.0",
  "description": "Send StikDesi sound stickers from WhatsApp Web.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lovable.app/*",
        "http://localhost/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "api.js",
        "whatsapp.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StikDesi Sender",
    "default_icon": "icon.png"
  },
  "host_permissions": [
    "https://c--70890fbc-f582-4dd0-8c61-da9b7b9595a9-prod.lovable.cloud/*"
  ]
}